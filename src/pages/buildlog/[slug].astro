---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import '../../styles/article.css';

export async function getStaticPaths() {
  const posts = (await getCollection('buildlog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString().slice(0, 10),
  url: new URL(`/buildlog/${post.id}.html`, site.url).href,
  author: { '@type': 'Person', name: site.name, url: site.url },
  isPartOf: { '@type': 'Blog', name: `${site.name} build log`, url: new URL('/buildlog', site.url).href },
};
---
<Base title={d.title} description={d.summary} type="article" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="hero">
      <a href="/buildlog/" class="back"><Icon name="arrow" size={14} class="flip" /> Build log</a>
      <div class="eyebrow">{d.dateLabel} · <a href={site.azimuth.page}>AZIMUTH</a></div>
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>
    <article class="article"><Content /></article>
    <nav class="pager" aria-label="Other posts">
      {older ? <a href={`/buildlog/${older.id}.html`} class="tile card-link"><span class="label">Earlier</span><span>{older.data.title}</span></a> : <span />}
      {newer ? <a href={`/buildlog/${newer.id}.html`} class="tile card-link right"><span class="label">Later</span><span>{newer.data.title}</span></a> : <span />}
    </nav>
  </div>
</Base>

<style>
  .wrap { padding-top: 40px; padding-bottom: 72px; }
  .hero, .article, .pager { max-width: 760px; margin-left: auto; margin-right: auto; }
  .hero { display: flex; flex-direction: column; gap: 14px; margin-bottom: 40px; }
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--ink-3); margin-bottom: 8px; }
  .back:hover { color: var(--ink); }
  :global(.flip) { transform: rotate(180deg); }
  .eyebrow a { color: inherit; }
  h1 { font-size: clamp(30px, 4.2vw, 44px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; }
  .summary { color: var(--ink-2); font-size: 18px; line-height: 1.5; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 56px; }
  .pager a { padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; font-weight: 600; font-size: 15px; }
  .pager .right { text-align: right; align-items: flex-end; }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } }
</style>
