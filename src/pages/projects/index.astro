---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const personal = all.filter((p) => p.data.category === 'Self-directed');
const studies = all.filter((p) => p.data.category !== 'Self-directed');
const azimuth = personal.find((p) => p.id === 'azimuth');
const otherPersonal = personal.filter((p) => p.id !== 'azimuth');
---
<Base title="Projects" description="Case studies in SQL, Python, R, Tableau and Excel, plus AZIMUTH, a launch-market BI platform, and Beat Otto, an iOS game. By Ignacio de Pablo.">
  <div class="wrap page">
    <header class="head">
      <div class="eyebrow">Portfolio</div>
      <h1>Projects</h1>
      <p>Each one starts from a real question and real data. The self-directed builds are larger and engineered end to end; the case studies take a dataset or a brief from my studies and carry it further.</p>
    </header>

    <section class="section">
      <div class="section-head"><div><div class="eyebrow">Self-directed</div><h2 class="sec">Built end to end</h2></div></div>
      {azimuth && <ProjectCard project={azimuth} size="wide" />}
      <div class="grid-3">{otherPersonal.map((p) => <ProjectCard project={p} />)}</div>
    </section>

    <section class="section">
      <div class="section-head"><div><div class="eyebrow">Case studies</div><h2 class="sec">Analysis on real data</h2></div></div>
      <div class="grid-3">{studies.map((p) => <ProjectCard project={p} />)}</div>
    </section>
  </div>
</Base>

<style>
  .page { padding-top: 40px; gap: 64px; }
  .head { max-width: 640px; display: flex; flex-direction: column; gap: 10px; }
  h1 { font-size: clamp(34px, 4.5vw, 48px); font-weight: 800; letter-spacing: -0.03em; }
  .head p { color: var(--ink-2); font-size: 17px; line-height: 1.55; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 1000px) { .grid-3 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .grid-3 { grid-template-columns: 1fr; } }
</style>
