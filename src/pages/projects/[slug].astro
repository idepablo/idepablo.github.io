---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import AzimuthEmbed from '../../components/AzimuthEmbed.astro';
import { site } from '../../data/site';
import '../../styles/article.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft && !data.external);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const isAzimuth = project.id === 'azimuth';
const posts = isAzimuth
  ? (await getCollection('buildlog', ({ data }) => !data.draft && data.project === 'azimuth')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : [];
const ogImage = d.cover ? d.cover.src : '/og-image.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': isAzimuth ? 'SoftwareApplication' : 'Article',
  name: d.title,
  headline: d.title,
  description: d.description,
  url: new URL(`/projects/${project.id}.html`, site.url).href,
  datePublished: d.date.toISOString().slice(0, 10),
  author: { '@type': 'Person', name: site.name, url: site.url },
  ...(isAzimuth ? { applicationCategory: 'BusinessApplication', operatingSystem: 'Web', codeRepository: site.azimuth.repo } : {}),
};
---
<Base title={d.title} description={d.description} image={ogImage} type="article" jsonLd={jsonLd}>
  <div class="wrap">
    <header class="hero">
      <a href="/projects/" class="back"><Icon name="arrow" size={14} class="flip" /> All projects</a>
      {d.eyebrow && <div class="eyebrow">{d.eyebrow}</div>}
      <h1>{d.title}</h1>
      {d.byline && <p class="byline">{d.byline}</p>}
      <div class="meta">
        <div class="chips">
          {d.pills.map((p) => <span class="chip">{p}</span>)}
        </div>
        {(isAzimuth || d.links.length > 0) && (
          <div class="links">
            {isAzimuth && <a href={site.azimuth.app} class="btn btn-dark" rel="noopener" target="_blank">Open the live app <Icon name="external" size={14} /></a>}
            {isAzimuth && <a href={site.azimuth.repo} class="btn btn-light" rel="noopener" target="_blank">Repository <Icon name="external" size={14} /></a>}
            {d.links.map((l) => <a href={l.href} class="btn btn-light" rel="noopener" target="_blank">{l.label} <Icon name="external" size={14} /></a>)}
          </div>
        )}
      </div>
      {d.stats.length > 0 && (
        <div class="stats">
          {d.stats.map((s) => (
            <div class="tile stat"><b>{s.num}</b><span>{s.cap}</span></div>
          ))}
        </div>
      )}
      {d.cover && !isAzimuth && (
        <Image src={d.cover} alt="" widths={[760, 1200, 1600]} sizes="(max-width: 800px) 100vw, 760px" class="cover" loading="eager" />
      )}
    </header>

    {isAzimuth && (
      <section class="embed-wrap" aria-label="Live app">
        <AzimuthEmbed />
      </section>
    )}

    <article class="article">
      <Content />
    </article>

    {isAzimuth && (
      <section class="log" id="buildlog">
        <div class="eyebrow">Build log</div>
        <h2>One post per phase</h2>
        <ol class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/buildlog/${p.id}.html`} class="tile card-link post">
                <span class="label">{p.data.dateLabel}</span>
                <h3>{p.data.title}</h3>
                <p>{p.data.summary}</p>
                <span class="card-cta">Read the post <Icon name="arrow" size={14} /></span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <footer class="cta tile tile-dark">
      <h2>Questions about this project?</h2>
      <p>Happy to walk through the data, the decisions, or anything I would do differently.</p>
      <div class="actions">
        <a href={`mailto:${site.email}`} class="btn btn-white">Email me</a>
        <a href="/projects/" class="btn btn-ghost">More projects</a>
      </div>
    </footer>
  </div>
</Base>

<style>
  .wrap { padding-top: 40px; padding-bottom: 72px; }
  .hero, .article, .log, .cta, .embed-wrap { max-width: 760px; margin-left: auto; margin-right: auto; }
  .hero { display: flex; flex-direction: column; gap: 16px; margin-bottom: 44px; }
  .back { display: inline-flex; align-items: center; gap: 6px; font-size: 13.5px; font-weight: 600; color: var(--ink-3); margin-bottom: 8px; }
  .back:hover { color: var(--ink); }
  :global(.flip) { transform: rotate(180deg); }
  h1 { font-size: clamp(30px, 4.2vw, 44px); font-weight: 800; letter-spacing: -0.03em; line-height: 1.08; }
  .byline { color: var(--ink-3); font-size: 15px; }
  .meta { display: flex; flex-direction: column; gap: 14px; margin-top: 6px; }
  .links { display: flex; gap: 10px; flex-wrap: wrap; }
  .links .btn { height: 42px; font-size: 14px; padding: 0 16px; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-top: 12px; }
  .stat { padding: 16px; display: flex; flex-direction: column; gap: 6px; }
  .stat b { font-size: 22px; letter-spacing: -0.02em; line-height: 1.1; }
  .stat span { font-size: 12.5px; color: var(--ink-3); line-height: 1.35; }
  .cover { width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--line); margin-top: 12px; aspect-ratio: 16 / 8; object-fit: cover; }
  .embed-wrap { margin-bottom: 44px; }
  .log { margin-top: 64px; display: flex; flex-direction: column; gap: 16px; }
  .log h2 { font-size: 26px; font-weight: 700; margin-bottom: 8px; }
  .posts { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .post { padding: 22px 24px; display: flex; flex-direction: column; gap: 8px; }
  .post h3 { font-size: 18px; font-weight: 650; }
  .post p { color: var(--ink-2); font-size: 15px; line-height: 1.5; }
  .post .card-cta { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; }
  .cta { margin-top: 64px; padding: 40px; display: flex; flex-direction: column; gap: 10px; }
  .cta h2 { font-size: 24px; font-weight: 700; }
  .cta p { color: var(--on-dark-2); margin-bottom: 14px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 720px) {
    .stats { grid-template-columns: 1fr 1fr; }
    .cta { padding: 28px; }
    .cover { aspect-ratio: 16 / 10; }
  }
</style>

<script>
  // Third-party embeds load only when the visitor asks for them.
  document.querySelectorAll<HTMLElement>('[data-tableau]').forEach((box) => {
    box.querySelector('[data-load]')?.addEventListener('click', async () => {
      const src = box.dataset.tableau;
      if (!src) return;
      if (!customElements.get('tableau-viz')) {
        await new Promise<void>((resolve, reject) => {
          const s = document.createElement('script');
          s.type = 'module';
          s.src = 'https://public.tableau.com/javascripts/api/tableau.embedding.3.latest.min.js';
          s.onload = () => resolve();
          s.onerror = () => reject();
          document.head.appendChild(s);
        }).catch(() => undefined);
      }
      const viz = document.createElement('tableau-viz');
      viz.setAttribute('src', src);
      viz.setAttribute('toolbar', 'bottom');
      viz.setAttribute('hide-tabs', '');
      box.querySelector('.viz-poster')?.replaceWith(viz);
      box.classList.add('loaded');
    });
  });
</script>
