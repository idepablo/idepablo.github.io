---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" noindex>
  <div class="wrap nf">
    <div class="eyebrow">404</div>
    <h1>That page is not here.</h1>
    <p>It may have moved when the site was rebuilt. The projects and build log are one click away.</p>
    <div class="actions">
      <a href="/" class="btn btn-dark">Home <Icon name="arrow" size={16} /></a>
      <a href="/projects/" class="btn btn-light">Projects</a>
      <a href="/buildlog/" class="btn btn-light">Build log</a>
    </div>
  </div>
</Base>
<style>
  .nf { padding-top: 80px; padding-bottom: 120px; max-width: 640px; display: flex; flex-direction: column; gap: 12px; }
  h1 { font-size: clamp(32px, 4.5vw, 44px); font-weight: 800; letter-spacing: -0.03em; }
  p { color: var(--ink-2); font-size: 17px; margin-bottom: 12px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
