---
// Preview card for the live AZIMUTH app. It links out instead of embedding: Streamlit Community
// Cloud apps inside an iframe stall when the visitor's browser blocks third-party cookies
// (Chrome's default for many users), so an embed would show a spinner to a good share of visitors.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { site } from '../data/site';
import shot from '../assets/azimuth-market.jpg';
---
<a href={site.azimuth.app} class="preview tile card-link" rel="noopener" target="_blank">
  <Image src={shot} alt="AZIMUTH Market Overview: orbital launch attempts per year and share of attempts in 2025" widths={[480, 760, 1200]} sizes="(max-width: 800px) 100vw, 760px" loading="eager" fetchpriority="high" />
  <div class="overlay">
    <div class="status"><span class="label">Live app · updated daily</span></div>
    <span class="btn btn-white">Open the app <Icon name="external" size={14} /></span>
    <span class="note">Opens azimuth-launch.streamlit.app in a new tab. Best on a desktop screen.</span>
  </div>
</a>

<style>
  .preview { position: relative; display: block; overflow: hidden; background: var(--dark-2); border-color: var(--dark-2); aspect-ratio: 16 / 9; }
  .preview img { width: 100%; height: 100%; object-fit: cover; object-position: left top; display: block; opacity: 0.55; transition: opacity .2s ease; }
  .preview:hover img { opacity: 0.7; }
  .overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 24px; text-align: center; }
  .status { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
  .overlay .label { color: #C5CBD4; }
  .note { font-size: 13px; color: #C5CBD4; }
</style>
